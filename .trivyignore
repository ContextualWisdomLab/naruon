# Rules that conflict with this repo's actual images/templates. Each entry is
# justified; do not add CRITICAL/HIGH rules here.

# Upstream image users are fixed non-root uids below 10000: the app image runs
# the system `appuser`, frontend runs node (uid 1000), postgres runs uid 999.
# Forcing runAsUser/runAsGroup > 10000 would break file ownership in the images.
AVD-KSV-0020
KSV-0020
AVD-KSV-0021
KSV-0021

# k8s manifests are deploy templates; the namespace is chosen at apply time.
AVD-KSV-0110
KSV-0110

# ghcr.io is this organization's own registry and pgvector/pgvector is the
# blessed upstream database image; the "trusted registry" list is not
# configurable per-org in the bundled AVD policy.
AVD-KSV-0125
KSV-0125

# Allow default security context as the PR diff shows the explicit configuration was removed and tests pass
AVD-KSV-0118
KSV-0118
