{
  "noema-general-agent": {
    "agent_id": "noema-general-agent",
    "agent_name": "Noema General Agent",
    "agent_framework": "pydantic-ai",
    "framework_license": "MIT",
    "agent_entrypoint": "services.noema_agent:run_noema_agent",
    "agent_description": "General-purpose assistant that reasons over the naruon workspace (mail, content graph, tasks) on the tenant's configured LLM provider and dispatches opt-in, audit-logged writebacks through the self-hosted runner.",
    "agent_capabilities": [
      "mail.search",
      "mail.read",
      "content_graph.query",
      "tasks.read",
      "tasks.update",
      "calendar.writeback"
    ],
    "provider_source": "runtime_llm_provider",
    "writeback": {
      "opt_in": true,
      "audit_logged": true
    },
    "degrades_gracefully": true,
    "agent_enabled": true
  }
}
