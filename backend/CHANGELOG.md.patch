import re

with open("CHANGELOG.md", "r") as f:
    content = f.read()

header = "## [Unreleased]\n\n"
if header in content:
    content = content.replace(header, header + "### 보안 (Security)\n- `carddav_discovery.py`에서 `unquote()`를 사용하여 컨텍스트 경로 검증 시 URL 인코딩된 경로 탐색(Path Traversal) 문자가 우회할 수 없도록 방어 로직 추가\n\n")
    with open("CHANGELOG.md", "w") as f:
        f.write(content)
